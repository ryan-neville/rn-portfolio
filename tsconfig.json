{
  "compilerOptions": {
    // Matches the japanese-flashcard-app submodule's target. Files reached via
    // import are type-checked under this config regardless of `exclude`, so the
    // submodule's own tsconfig never applies during a portfolio build.
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // The vowel-movement submodule imports its own files through the same
      // `@/` prefix this project uses, but rooted at its own directory —
      // `@/components/Game`, `@/lib/puzzle`, `@/data/puzzles.json`. Resolving
      // those against the portfolio root would miss. Each shared prefix lists
      // the portfolio's own directory first so this project always wins, then
      // falls back to the submodule; Next feeds these same entries to webpack
      // via JsConfigPathsPlugin, so bundling and type-checking agree.
      // Only `components` actually exists on both sides, and no filename is
      // shared between the two, so nothing is shadowed today.
      "@/components/*": [
        "./components/*",
        "./projects/vowel-movement/components/*"
      ],
      "@/hooks/*": [
        "./hooks/*",
        "./projects/vowel-movement/hooks/*"
      ],
      "@/lib/*": [
        "./lib/*",
        "./projects/vowel-movement/lib/*"
      ],
      "@/data/*": [
        "./data/*",
        "./projects/vowel-movement/data/*"
      ],
      "@/*": [
        "./*"
      ],
      // The submodule ships its own node_modules (Next 16, React 19 types),
      // which shadows this project's when its files are type-checked. webpack
      // already aliases react/react-dom/next to this project's copies, so pin
      // type resolution to the same ones. Without this the two React type
      // identities clash and `Link` is rejected as a JSX component.
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "next": [
        "./node_modules/next"
      ],
      "next/*": [
        "./node_modules/next/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "projects"
  ]
}
